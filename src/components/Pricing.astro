---
const purchaseUrl = 'https://www.lmnoeng.com/register.php';

const plans = [
  { term: '7 days', price: 40, computers: '1 to 5 computers', note: 'For a single project', days: 7 },
  { term: '90 days', price: 90, computers: '1 to 5 computers', note: 'For a season of design work', days: 90 },
  { term: '1 year', price: 200, computers: '1 to 5 computers', note: 'Lowest daily cost', days: 365, featured: true },
  { term: '30 days', price: 120, computers: 'Up to 30 computers', note: 'For a team or classroom', days: 30 },
];

const included = [
  'Full features on all 55 PIN-required programs',
  'SI and US units',
  'Documented equations and references',
];

const steps = [
  { title: 'Choose a plan', text: 'Pay securely with PayPal, or by credit card over the phone.' },
  { title: 'Get your PIN', text: 'It arrives by email, usually within a minute and at most 30 minutes.' },
  { title: 'Start calculating', text: 'Enter the PIN on the home page to activate the full library.' },
];
---

<section id="pricing" class="section pricing">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Pricing</span>
      <h2>Free for quick checks. Subscribe for design work.</h2>
      <p>29 tools and references are free, including the simple Manning, V-notch weir, Darcy-Weisbach, and Hazen-Williams calculators. A subscription adds full features on the specialty programs.</p>
    </div>

    <div class="plans">
      {
        plans.map((p) => (
          <article class:list={['plan', 'reveal', { featured: p.featured }]}>
            <h3>{p.term}</h3>
            <p class="note">{p.note}</p>
            <p class="price"><span>$</span>{p.price}</p>
            <p class="meta">USD for {p.computers.toLowerCase()}</p>
            <p class="daily">${(p.price / p.days).toFixed(2)} per day</p>
            <a href={purchaseUrl} class:list={['btn', p.featured ? 'btn-primary' : 'btn-dark']}>Choose {p.term}</a>
          </article>
        ))
      }
    </div>

    <div class="details reveal">
      <div class="included">
        <h3>Included in every plan</h3>
        <ul>
          {
            included.map((item) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                {item}
              </li>
            ))
          }
        </ul>
        <p class="guarantee"><strong>30-day refund.</strong> If you aren't completely satisfied with the quality and accessibility of the site, tell us within 30 days of purchase and we'll refund your payment.</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <div>
                <h4>{s.title}</h4>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="custom reveal">
      Need a different term, or licenses for a class or large company? Call <a href="tel:+17407072614">(740) 707-2614</a> or email <a href="mailto:LMNO@LMNOeng.com">LMNO@LMNOeng.com</a>.
    </p>
  </div>
</section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .plan {
    display: flex;
    flex-direction: column;
    padding: 26px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .plan.featured {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  h3 {
    font-size: 22px;
  }
  .note {
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
  .price {
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .price span {
    font-size: 26px;
    vertical-align: 20px;
    margin-right: 2px;
  }
  .meta {
    margin-top: 10px;
    font-size: 14.5px;
  }
  .daily {
    margin: 2px 0 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .featured .note,
  .featured .daily {
    color: var(--muted-light);
  }
  .plan .btn {
    margin-top: auto;
    width: 100%;
    padding-inline: 12px;
  }
  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    margin-top: 48px;
  }
  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .included ul {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  .included li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .included svg {
    color: var(--water);
    flex: none;
  }
  .guarantee {
    margin-top: 20px;
    font-size: 15px;
    color: var(--muted);
  }
  .guarantee strong {
    color: var(--text);
  }
  .steps {
    display: grid;
    gap: 18px;
  }
  .steps li {
    display: flex;
    gap: 14px;
  }
  .num {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--water-soft);
    color: #0b63b5;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
  }
  h4 {
    font-family: var(--font-sans);
    font-size: 16px;
    letter-spacing: 0;
    line-height: 1.5;
  }
  .steps p {
    font-size: 15px;
    color: var(--muted);
  }
  .custom {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .custom a {
    color: #0b63b5;
    white-space: nowrap;
  }
  @media (max-width: 1040px) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 760px) {
    .details {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  @media (max-width: 520px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
