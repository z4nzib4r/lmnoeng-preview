---
const services = [
  {
    title: 'Hydraulic design & analysis',
    desc: 'Open channel, culvert, and pipe network design, with capacity checks and documented calculations.',
  },
  {
    title: 'Stormwater & hydrology',
    desc: 'Runoff modeling, detention sizing, and drainage studies for sites and watersheds.',
  },
  {
    title: 'Flow measurement',
    desc: 'Weir, flume, and meter selection, sizing, and rating curves for treatment plants and field sites.',
  },
  {
    title: 'Environmental modeling',
    desc: 'Air dispersion, groundwater, and contaminant transport analyses for permitting and research.',
  },
  {
    title: 'Custom engineering software',
    desc: 'Calculation tools, spreadsheets, and web apps built for your team’s workflows and standards.',
  },
  {
    title: 'Expert review & research',
    desc: 'Independent technical review, peer checks, and applied research in fluid mechanics.',
  },
];

const steps = [
  { n: '01', t: 'Tell us the problem', d: 'Share the site, the data you have, and the decision you need to make.' },
  { n: '02', t: 'Scoped proposal', d: 'You get a clear scope, schedule, and fixed or not-to-exceed fee.' },
  { n: '03', t: 'Engineered results', d: 'Calculations, a report, or software, with every assumption documented.' },
];
---

<section id="consulting" class="section consulting">
  <div class="container">
    <div class="split">
      <div class="section-head reveal">
        <span class="eyebrow">Consulting</span>
        <h2>When a calculator isn't enough.</h2>
        <p>
          The engineers behind the calculators take on consulting work: hydraulic and environmental analysis,
          expert review, and custom software for agencies, firms, and manufacturers.
        </p>
        <a href="#contact" class="btn btn-primary">Discuss your project</a>
      </div>
      <ol class="steps reveal">
        {
          steps.map((s) => (
            <li>
              <span>{s.n}</span>
              <div>
                <h4>{s.t}</h4>
                <p>{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="services">
      {
        services.map((s) => (
          <div class="svc reveal">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .consulting {
    background: var(--ink);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .consulting::before {
    content: '';
    position: absolute;
    width: 700px;
    height: 700px;
    left: -250px;
    bottom: -350px;
    background: radial-gradient(circle, rgba(31, 142, 241, 0.25), transparent 65%);
  }
  .container {
    position: relative;
  }
  .eyebrow {
    color: var(--water-2);
  }
  .section-head p {
    color: var(--muted-light);
  }
  .section-head .btn {
    margin-top: 28px;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-lg);
  }
  .steps li {
    display: flex;
    gap: 18px;
    padding: 20px;
  }
  .steps li + li {
    border-top: 1px solid var(--line-dark);
  }
  .steps span {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--water-2);
    padding-top: 3px;
  }
  .steps h4 {
    font-size: 18px;
  }
  .steps p {
    color: var(--muted-light);
    font-size: 15px;
    margin-top: 4px;
  }
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 72px;
    background: var(--line-dark);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .svc {
    background: var(--ink);
    padding: 30px;
    transition: background 0.2s;
  }
  .svc:hover {
    background: var(--ink-2);
  }
  .svc h3 {
    font-size: 19px;
  }
  .svc p {
    color: var(--muted-light);
    font-size: 15px;
    margin-top: 10px;
  }
  @media (max-width: 960px) {
    .split {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .services {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .services {
      grid-template-columns: 1fr;
      margin-top: 48px;
    }
    .svc {
      padding: 24px;
    }
    .steps li {
      padding: 16px;
    }
  }
</style>
