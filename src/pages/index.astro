---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Calculators from '../components/Calculators.astro';
import Popular from '../components/Popular.astro';
import Consulting from '../components/Consulting.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="LMNO Engineering | Fluid Flow, Hydrology & Environmental Calculators"
  description="Free online engineering calculators for open channel flow, pipe flow, weirs, flumes, hydrology, groundwater, and environmental engineering, plus consulting and custom software from LMNO Engineering."
>
  <Header />
  <main>
    <Hero />
    <Calculators />
    <Popular />
    <Consulting />
    <About />
    <Contact />
  </main>
  <Footer />
</Base>
