---
import { popular } from '../data/calculators';
---

<section id="popular" class="section popular">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Most used</span>
      <h2>Engineers' go-to calculators.</h2>
      <p>The tools practicing engineers, students, and operators return to most.</p>
    </div>
    <div class="list">
      {
        popular.map((p, i) => (
          <a href="#" class="row reveal">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div class="body">
              <span class="cat">{p.category}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
            <code>{p.eq}</code>
            <span class="go" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .popular {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 48px;
  }
  .row {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 20px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    align-self: start;
    padding-top: 4px;
  }
  .cat {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--water);
  }
  h3 {
    font-size: 21px;
    margin-top: 4px;
  }
  .body p {
    color: var(--muted);
    font-size: 14.5px;
    margin-top: 4px;
  }
  code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .go {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--ink);
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .row:hover .go {
    background: var(--water);
    border-color: var(--water);
    color: #fff;
    transform: rotate(45deg);
  }
  .row:hover h3 {
    color: var(--water);
  }
  @media (max-width: 1100px) {
    code {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }
    .num {
      display: none;
    }
  }
</style>
