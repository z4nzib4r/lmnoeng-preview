---
import Logo from './Logo.astro';

const links = [
  { label: 'Calculators', href: '/#calculators' },
  { label: 'Popular', href: '/#popular' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Consulting', href: '/#consulting' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="header" data-header>
  <div class="container bar">
    <Logo light />
    <nav class="nav" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a href="/#calculators" class="search" aria-label="Search calculators">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span>Find a calculator</span>
        <kbd>/</kbd>
      </a>
      <a href="/#contact" class="btn btn-primary cta">Get a quote</a>
      <button class="menu-btn" aria-label="Open menu" aria-expanded="false" data-menu-btn>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile" data-mobile hidden>
    <div class="container">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/#contact" class="btn btn-primary">Get a quote</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      backdrop-filter 0.25s ease;
    border-bottom: 1px solid transparent;
  }
  .header.scrolled,
  .header.open {
    background: rgba(11, 27, 43, 0.86);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-color: var(--line-dark);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 76px;
  }
  .nav {
    display: flex;
    gap: 4px;
  }
  .nav a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 999px;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .nav a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .search {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 10px 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-dark);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    text-decoration: none;
  }
  .search:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid var(--line-dark);
  }
  .cta {
    height: 42px;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--line-dark);
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .menu-btn span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.2s;
  }
  .menu-btn span:first-child {
    top: 17px;
  }
  .menu-btn span:last-child {
    top: 25px;
  }
  .open .menu-btn span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .open .menu-btn span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .mobile .container {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 24px;
  }
  .mobile a:not(.btn) {
    color: #fff;
    text-decoration: none;
    font-size: 18px;
    font-weight: 500;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-dark);
  }
  .mobile .btn {
    margin-top: 16px;
  }

  @media (max-width: 1080px) {
    .search span,
    .search kbd {
      display: none;
    }
    .search {
      width: 42px;
      padding: 0;
      justify-content: center;
    }
  }
  @media (max-width: 900px) {
    .nav,
    .cta {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const mobile = document.querySelector<HTMLElement>('[data-mobile]')!;

  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    header.classList.toggle('open', open);
    mobile.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn.addEventListener('click', () => setOpen(mobile.hidden));
  mobile.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName)) {
      e.preventDefault();
      const input = document.querySelector<HTMLInputElement>('[data-calc-search]');
      input?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      input?.focus({ preventScroll: true });
    }
  });
</script>
