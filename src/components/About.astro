---
const pillars = [
  {
    title: 'A named, licensed engineer',
    desc: 'LMNO is co-owned by Ken Edwards, Ph.D., P.E. A real name, email, and phone number are on the site, so you know who stands behind the numbers.',
    icon: 'M12 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0',
  },
  {
    title: 'In business since 1998',
    desc: 'For nearly three decades, LMNO has helped individuals and corporations with fluid dynamics and water resources problems.',
    icon: 'M12 7v5l3 2M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18z',
  },
  {
    title: 'Built for design problems',
    desc: 'Beyond the standard equations, 55 PIN-required programs take on work like culvert inlet control, water hammer, and pipe networks.',
    icon: 'M3 7v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M3 13c3 0 3-2 6-2s3 2 6 2 3-2 6-2',
  },
  {
    title: 'Limits in plain sight',
    desc: 'Calculators document their equations, variables, valid ranges, and references, so you can check the work before it goes into a design.',
    icon: 'M4 7V4h16v3M9 20h6M12 4v16',
  },
];

const comparison = [
  ['Who stands behind it', 'Co-owners Ken Edwards, Ph.D., P.E., and Debbie Edwards, with a published email and phone number', 'Usually an editorial or content team'],
  ['Focus', 'Fluid dynamics, water resources, and environmental engineering', 'Thousands of topics, from finance to physics'],
  ['Depth', 'Quick checks plus specialty design programs', 'Mostly everyday formulas'],
  ['Paid for by', 'Subscriptions and consulting, not advertising', 'Usually advertising'],
  ['When the answer is not enough', 'Hire the engineers behind the tools', 'Self-serve only'],
];
---

<section id="about" class="section">
  <div class="container grid">
    <div>
      <div class="section-head reveal">
        <span class="eyebrow">Why LMNO</span>
        <h2>Results you can put your name on.</h2>
        <p>
          General calculator sites are great for a quick answer. When a number goes into a design,
          you need to know who built the tool, what it assumes, and where it stops being valid.
        </p>
      </div>
      <div class="pillars">
        {
          pillars.map((p) => (
            <div class="pillar reveal">
              <div class="icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={p.icon} />
                </svg>
              </div>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <figure class="sheet reveal" aria-label="Example calculation output">
      <header>
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="file">v-notch-weir · results</span>
      </header>
      <div class="sheet-body">
        <p class="label">Inputs</p>
        <table>
          <tbody>
            <tr><td>Notch angle, θ</td><td>90°</td></tr>
            <tr><td>Head over vertex, H</td><td>0.250 m</td></tr>
            <tr><td>Discharge coeff., C<sub>e</sub></td><td>0.578</td></tr>
          </tbody>
        </table>
        <p class="label">Equation</p>
        <div class="eq">Q = (8/15) · C<sub>e</sub> · √(2g) · tan(θ/2) · H<sup>5/2</sup></div>
        <p class="label">Result</p>
        <div class="result">
          <span>Q</span>
          <strong>0.0427</strong>
          <em>m³/s</em>
        </div>
        <p class="ref">Ref: ISO 1438 · Bos, M.G., <i>Discharge Measurement Structures</i></p>
      </div>
    </figure>
  </div>
  <div class="container">
    <div class="compare reveal">
      <h3>How LMNO compares</h3>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <td></td>
              <th scope="col">LMNO Engineering</th>
              <th scope="col">General calculator sites</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map(([label, lmno, other]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td class="us" data-label="LMNO Engineering">{lmno}</td>
                  <td data-label="General calculator sites">{other}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .compare {
    margin-top: 72px;
  }
  .compare h3 {
    font-size: 26px;
    margin-bottom: 18px;
  }
  .scroll {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .compare table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 15.5px;
  }
  .compare th,
  .compare td {
    width: 37%;
    padding: 15px 22px;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-weight: 400;
  }
  .compare td:last-child,
  .compare td:first-child {
    font-family: var(--font-sans);
    font-size: 15.5px;
    text-align: left;
    white-space: normal;
  }
  .compare td,
  .compare th {
    border-bottom: 0;
  }
  .compare tr > :first-child {
    width: 26%;
  }
  @media (max-width: 640px) {
    .compare table {
      min-width: 0;
      display: block;
    }
    .compare thead {
      display: none;
    }
    .compare tbody,
    .compare tr {
      display: block;
    }
    .compare tr {
      padding: 14px 18px;
      border-top: 1px solid var(--line);
    }
    .compare tr:first-child {
      border-top: 0;
    }
    .compare tr > :first-child,
    .compare th,
    .compare td {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
    }
    .compare td {
      margin-top: 8px;
    }
    .compare td::before {
      content: attr(data-label);
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
    }
  }
  .compare thead th,
  .compare thead td {
    border-top: 0;
    color: var(--text);
    font-weight: 600;
  }
  .compare tbody th {
    color: var(--text);
    font-weight: 600;
  }
  .compare td.us {
    color: var(--text);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 72px;
    align-items: center;
  }
  .pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 36px;
  }
  .icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--ink);
    color: var(--water-2);
  }
  .pillar h3 {
    font-size: 18px;
    margin-top: 16px;
  }
  .pillar p {
    color: var(--muted);
    font-size: 15px;
    margin-top: 6px;
  }
  .sheet {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transform: rotate(1.2deg);
  }
  .sheet.in {
    transform: rotate(1.2deg);
  }
  .sheet header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d4dde6;
  }
  .file {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .sheet-body {
    padding: 22px 24px 26px;
  }
  .label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--water);
    margin: 18px 0 8px;
  }
  .label:first-child {
    margin-top: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  td {
    padding: 7px 0;
    border-bottom: 1px dashed var(--line);
  }
  td:last-child {
    text-align: right;
    font-family: var(--font-mono);
  }
  .eq {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px;
    overflow-x: auto;
    white-space: nowrap;
  }
  .result {
    display: flex;
    align-items: baseline;
    gap: 12px;
    background: var(--ink);
    color: #fff;
    border-radius: 12px;
    padding: 14px 18px;
  }
  .result span,
  .result em {
    font-family: var(--font-mono);
    font-style: normal;
    color: var(--muted-light);
  }
  .result strong {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 500;
    color: var(--water-2);
  }
  .ref {
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .sheet,
    .sheet.in {
      transform: none;
      max-width: 520px;
    }
  }
  @media (max-width: 560px) {
    .pillars {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
