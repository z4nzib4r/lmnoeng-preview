---
---

<section id="contact" class="section contact">
  <div class="container">
    <div class="panel reveal">
      <div class="copy">
        <span class="eyebrow">Get in touch</span>
        <h2>Have a flow problem? Let's solve it.</h2>
        <p>
          Tell us about your project, whether it's a quick check or a full study. You'll hear back
          from an engineer, not a sales team.
        </p>
        <ul class="meta">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
            <span>[email address]</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
            <span>[phone number]</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>[office address]</span>
          </li>
        </ul>
      </div>

      <form class="form" data-form>
        <div class="row">
          <label>
            <span>Name</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          <span>Organization <em>(optional)</em></span>
          <input name="org" autocomplete="organization" />
        </label>
        <label>
          <span>What do you need help with?</span>
          <select name="topic">
            <option>Hydraulic design &amp; analysis</option>
            <option>Stormwater &amp; hydrology</option>
            <option>Flow measurement</option>
            <option>Environmental modeling</option>
            <option>Custom software</option>
            <option>Question about a calculator</option>
          </select>
        </label>
        <label>
          <span>Project details</span>
          <textarea name="message" rows="4" required></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Send message</button>
        <p class="note" data-note role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    background: linear-gradient(135deg, var(--water-soft), #fff 60%);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 56px;
    box-shadow: var(--shadow);
  }
  h2 {
    font-size: clamp(30px, 3.6vw, 44px);
    margin-top: 14px;
  }
  .copy > p {
    margin-top: 16px;
    color: var(--muted);
    font-size: 17px;
  }
  .meta {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    gap: 14px;
  }
  .meta li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
  }
  .meta svg {
    color: var(--water);
    flex-shrink: 0;
  }
  .form {
    display: grid;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 28px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  label span {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  label em {
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    font: 15px var(--font-sans);
    color: var(--text);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 11px 13px;
    outline: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--water);
    box-shadow: 0 0 0 3px rgba(31, 142, 241, 0.15);
  }
  .form .btn {
    margin-top: 6px;
  }
  .note {
    font-size: 14px;
    color: #0f7a3d;
    min-height: 1em;
  }
  @media (max-width: 960px) {
    .panel {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 40px;
    }
  }
  @media (max-width: 560px) {
    .panel {
      padding: 24px 18px;
      border-radius: 22px;
    }
    .form {
      padding: 20px;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Front-end only concept: no backend is wired up yet.
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const note = document.querySelector<HTMLElement>('[data-note]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    note.textContent = 'Thanks! Your message is ready to send. (Demo only: this form isn’t connected yet.)';
    form.reset();
  });
</script>
