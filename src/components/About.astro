---
const pillars = [
  {
    title: 'Transparent math',
    desc: 'Every calculator shows its governing equations, variable definitions, valid ranges, and literature references. No black boxes.',
    icon: 'M4 7V4h16v3M9 20h6M12 4v16',
  },
  {
    title: 'Units your way',
    desc: 'Mix and match US customary and SI inputs. Conversions are handled for you and checked against standard references.',
    icon: 'M7 4 3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7',
  },
  {
    title: 'Fast on any device',
    desc: 'Instant results in the field, at your desk, or in the classroom. Nothing to install.',
    icon: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z',
  },
  {
    title: 'Built by engineers',
    desc: 'Developed and maintained by working engineers and researchers in fluid mechanics, hydrology, and environmental engineering.',
    icon: 'M12 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0',
  },
];
---

<section id="about" class="section">
  <div class="container grid">
    <div>
      <div class="section-head reveal">
        <span class="eyebrow">Why LMNO</span>
        <h2>Results you can put your name on.</h2>
        <p>
          LMNO Engineering, Research, and Software, Ltd. makes engineering calculations accessible
          without giving up rigor, so you can check the work as well as get the answer.
        </p>
      </div>
      <div class="pillars">
        {
          pillars.map((p) => (
            <div class="pillar reveal">
              <div class="icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={p.icon} />
                </svg>
              </div>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <figure class="sheet reveal" aria-label="Example calculation output">
      <header>
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="file">v-notch-weir · results</span>
      </header>
      <div class="sheet-body">
        <p class="label">Inputs</p>
        <table>
          <tbody>
            <tr><td>Notch angle, θ</td><td>90°</td></tr>
            <tr><td>Head over vertex, H</td><td>0.250 m</td></tr>
            <tr><td>Discharge coeff., C<sub>e</sub></td><td>0.578</td></tr>
          </tbody>
        </table>
        <p class="label">Equation</p>
        <div class="eq">Q = (8/15) · C<sub>e</sub> · √(2g) · tan(θ/2) · H<sup>5/2</sup></div>
        <p class="label">Result</p>
        <div class="result">
          <span>Q</span>
          <strong>0.0427</strong>
          <em>m³/s</em>
        </div>
        <p class="ref">Ref: ISO 1438 · Bos, M.G., <i>Discharge Measurement Structures</i></p>
      </div>
    </figure>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 72px;
    align-items: center;
  }
  .pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 36px;
  }
  .icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--ink);
    color: var(--water-2);
  }
  .pillar h3 {
    font-size: 18px;
    margin-top: 16px;
  }
  .pillar p {
    color: var(--muted);
    font-size: 15px;
    margin-top: 6px;
  }
  .sheet {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transform: rotate(1.2deg);
  }
  .sheet.in {
    transform: rotate(1.2deg);
  }
  .sheet header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d4dde6;
  }
  .file {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .sheet-body {
    padding: 22px 24px 26px;
  }
  .label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--water);
    margin: 18px 0 8px;
  }
  .label:first-child {
    margin-top: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  td {
    padding: 7px 0;
    border-bottom: 1px dashed var(--line);
  }
  td:last-child {
    text-align: right;
    font-family: var(--font-mono);
  }
  .eq {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px;
    overflow-x: auto;
    white-space: nowrap;
  }
  .result {
    display: flex;
    align-items: baseline;
    gap: 12px;
    background: var(--ink);
    color: #fff;
    border-radius: 12px;
    padding: 14px 18px;
  }
  .result span,
  .result em {
    font-family: var(--font-mono);
    font-style: normal;
    color: var(--muted-light);
  }
  .result strong {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 500;
    color: var(--water-2);
  }
  .ref {
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .sheet,
    .sheet.in {
      transform: none;
      max-width: 520px;
    }
  }
  @media (max-width: 560px) {
    .pillars {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
