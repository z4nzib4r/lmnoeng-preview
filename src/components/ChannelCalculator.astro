---
import { url } from '../lib/url';
const materials = [
  { label: 'Concrete', n: 0.013 },
  { label: 'PVC', n: 0.01 },
  { label: 'Corr. metal', n: 0.024 },
  { label: 'Clean earth', n: 0.022 },
  { label: 'Stream', n: 0.035 },
];
---

<div class="calc" data-calc>
  <div class="calc-head">
    <div>
      <span class="tag">Live demo</span>
      <h3>Manning's equation</h3>
      <p class="sub">Rectangular open channel</p>
    </div>
    <div class="units" role="radiogroup" aria-label="Units">
      <button type="button" role="radio" aria-checked="true" data-unit="si">SI</button>
      <button type="button" role="radio" aria-checked="false" data-unit="us">US</button>
    </div>
  </div>

  <svg class="xsec" viewBox="0 0 320 120" aria-hidden="true">
    <defs>
      <linearGradient id="water" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#5cc3ff" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="#1f8ef1" stop-opacity="0.75"></stop>
      </linearGradient>
    </defs>
    <rect data-water x="60" y="60" width="200" height="50" fill="url(#water)"></rect>
    <path data-surface d="" fill="none" stroke="#bfe8ff" stroke-width="1.5"></path>
    <path d="M60 8 V110 H260 V8" fill="none" stroke="#d6e2ee" stroke-width="3" stroke-linejoin="round"></path>
    <g font-family="JetBrains Mono, monospace" font-size="10" fill="#a9b8c8">
      <text x="160" y="119" text-anchor="middle" data-label-b>b</text>
      <text x="270" y="84" data-label-y>y</text>
    </g>
  </svg>

  <div class="fields">
    <label>
      <span>Bottom width <em>b</em></span>
      <div class="input"><input type="number" inputmode="decimal" step="any" min="0" value="3" data-in="b" /><i data-u="len">m</i></div>
    </label>
    <label>
      <span>Flow depth <em>y</em></span>
      <div class="input"><input type="number" inputmode="decimal" step="any" min="0" value="1.2" data-in="y" /><i data-u="len">m</i></div>
    </label>
    <label>
      <span>Slope <em>S</em></span>
      <div class="input"><input type="number" inputmode="decimal" step="any" min="0" value="0.002" data-in="s" /><i>m/m</i></div>
    </label>
    <label>
      <span>Lining <em>n</em></span>
      <div class="input select">
        <select data-in="n">
          {materials.map((m, i) => <option value={m.n} selected={i === 0}>{m.label} · {m.n}</option>)}
        </select>
      </div>
    </label>
  </div>

  <div class="out">
    <div class="primary">
      <span>Discharge Q</span>
      <strong><output data-out="q">0</output> <small data-u="flow">m³/s</small></strong>
    </div>
    <dl>
      <div><dt>Velocity</dt><dd><output data-out="v">0</output> <small data-u="vel">m/s</small></dd></div>
      <div><dt>Hyd. radius</dt><dd><output data-out="r">0</output> <small data-u="len">m</small></dd></div>
      <div><dt>Froude</dt><dd><output data-out="fr">0</output> <small data-out="regime"></small></dd></div>
    </dl>
  </div>
  <p class="formula">Q = (k/n) · A · R<sup>2/3</sup> · S<sup>1/2</sup></p>
  <a class="full" href={url('/calculators/circular-culvert')}>Open the full circular culvert calculator →</a>
</div>

<style>
  .calc {
    background: rgba(255, 255, 255, 0.98);
    color: var(--text);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }
  .calc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0f7a3d;
    background: #e5f7ec;
    padding: 3px 8px;
    border-radius: 999px;
  }
  .tag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #18b55c;
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  h3 {
    font-size: 22px;
    margin-top: 10px;
  }
  .sub {
    color: var(--muted);
    font-size: 14px;
  }
  .units {
    display: inline-flex;
    padding: 3px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .units button {
    border: 0;
    background: transparent;
    font: 600 13px var(--font-sans);
    color: var(--muted);
    padding: 6px 12px;
    border-radius: 999px;
    cursor: pointer;
  }
  .units button[aria-checked='true'] {
    background: var(--ink);
    color: #fff;
  }
  .xsec {
    width: 100%;
    height: auto;
    margin: 14px 0 6px;
  }
  .xsec rect,
  .xsec path[data-surface] {
    transition: all 0.35s ease;
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  label span {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 6px;
  }
  label em {
    font-family: var(--font-mono);
    font-style: normal;
    color: var(--water);
  }
  .input {
    display: flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .input:focus-within {
    border-color: var(--water);
    box-shadow: 0 0 0 3px rgba(31, 142, 241, 0.15);
  }
  .input input,
  .input select {
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    font: 500 15px var(--font-mono);
    color: var(--text);
    padding: 10px 12px;
    outline: none;
  }
  .input select {
    font: 500 13px var(--font-sans);
    cursor: pointer;
  }
  .input i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    padding-right: 12px;
  }
  .out {
    margin-top: 16px;
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius);
    padding: 16px 18px;
  }
  .primary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-dark);
  }
  .primary span {
    font-size: 13px;
    color: var(--muted-light);
  }
  .primary strong {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 500;
    color: var(--water-2);
  }
  .primary small,
  dd small {
    font-size: 12px;
    color: var(--muted-light);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 12px 0 0;
  }
  dt {
    font-size: 11px;
    color: var(--muted-light);
  }
  dd {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .formula {
    margin-top: 12px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .full {
    display: block;
    margin-top: 8px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: #0b63b5;
    text-decoration: none;
  }
  .full:hover {
    text-decoration: underline;
  }
  @media (max-width: 420px) {
    .calc {
      padding: 18px;
    }
    .fields {
      grid-template-columns: 1fr;
    }
    .primary strong {
      font-size: 24px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-calc]')!;
  const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
  const inputs = {
    b: $<HTMLInputElement>('[data-in="b"]'),
    y: $<HTMLInputElement>('[data-in="y"]'),
    s: $<HTMLInputElement>('[data-in="s"]'),
    n: $<HTMLSelectElement>('[data-in="n"]'),
  };
  const out = (k: string) => $<HTMLElement>(`[data-out="${k}"]`);
  const water = $<SVGRectElement>('[data-water]');
  const surface = $<SVGPathElement>('[data-surface]');
  const labelY = $<SVGTextElement>('[data-label-y]');

  const UNITS = {
    si: { k: 1, g: 9.81, len: 'm', vel: 'm/s', flow: 'm³/s', slope: 'm/m' },
    us: { k: 1.486, g: 32.174, len: 'ft', vel: 'ft/s', flow: 'ft³/s', slope: 'ft/ft' },
  } as const;
  type Unit = keyof typeof UNITS;
  let unit: Unit = 'si';

  const fmt = (x: number) => {
    if (!isFinite(x)) return '—';
    const a = Math.abs(x);
    if (a >= 1000) return x.toLocaleString(undefined, { maximumFractionDigits: 0 });
    if (a >= 100) return x.toFixed(1);
    if (a >= 1) return x.toFixed(3);
    return x.toPrecision(3);
  };

  function draw(b: number, y: number) {
    const left = 60, right = 260, bottom = 110, top = 14;
    const ratio = b > 0 ? Math.min(y / b, 1) : 0;
    const h = Math.max(2, ratio * (bottom - top));
    const yTop = bottom - h;
    water.setAttribute('y', String(yTop));
    water.setAttribute('height', String(h));
    surface.setAttribute(
      'd',
      `M${left} ${yTop} C ${left + 50} ${yTop - 3}, ${left + 80} ${yTop + 3}, ${(left + right) / 2} ${yTop} S ${right - 30} ${yTop - 3}, ${right} ${yTop}`,
    );
    labelY.setAttribute('y', String(yTop + h / 2 + 4));
  }

  function calc() {
    const u = UNITS[unit];
    const b = parseFloat(inputs.b.value);
    const y = parseFloat(inputs.y.value);
    const s = parseFloat(inputs.s.value);
    const n = parseFloat(inputs.n.value);
    const valid = b > 0 && y > 0 && s > 0 && n > 0;
    const A = b * y;
    const P = b + 2 * y;
    const R = A / P;
    const Q = valid ? (u.k / n) * A * Math.pow(R, 2 / 3) * Math.sqrt(s) : NaN;
    const V = Q / A;
    const Fr = V / Math.sqrt(u.g * y);
    out('q').textContent = fmt(Q);
    out('v').textContent = fmt(V);
    out('r').textContent = valid ? fmt(R) : '—';
    out('fr').textContent = valid ? Fr.toFixed(2) : '—';
    out('regime').textContent = !valid ? '' : Fr < 0.95 ? 'subcritical' : Fr > 1.05 ? 'supercritical' : 'critical';
    draw(b, y);
  }

  function setUnit(next: Unit) {
    if (next === unit) return;
    const f = next === 'us' ? 3.28084 : 1 / 3.28084;
    for (const k of ['b', 'y'] as const) {
      const v = parseFloat(inputs[k].value);
      if (isFinite(v)) inputs[k].value = String(+(v * f).toFixed(3));
    }
    unit = next;
    const u = UNITS[unit];
    root.querySelectorAll<HTMLElement>('[data-u]').forEach((el) => {
      el.textContent = u[el.dataset.u as 'len' | 'vel' | 'flow'];
    });
    inputs.s.nextElementSibling!.textContent = u.slope;
    root.querySelectorAll<HTMLButtonElement>('[data-unit]').forEach((btn) => {
      btn.setAttribute('aria-checked', String(btn.dataset.unit === unit));
    });
    calc();
  }

  root.querySelectorAll<HTMLButtonElement>('[data-unit]').forEach((btn) =>
    btn.addEventListener('click', () => setUnit(btn.dataset.unit as Unit)),
  );
  Object.values(inputs).forEach((el) => el.addEventListener('input', calc));
  calc();
</script>
