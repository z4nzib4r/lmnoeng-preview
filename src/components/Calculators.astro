---
import { url } from '../lib/url';
import { calcLinks, categories } from '../data/calculators';
const total = categories.reduce((n, c) => n + c.calcs.length, 0);
---

<section id="calculators" class="section">
  <div class="container">
    <div class="top">
      <div class="section-head reveal">
        <span class="eyebrow">Calculator library</span>
        <h2>Focused on fluids and water.</h2>
        <p>Not thousands of topics, just the ones engineers in this field work on. Start with free tools for quick checks, and subscribe when the problem gets harder.</p>
      </div>
      <div class="search reveal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input type="search" placeholder={`Search ${total}+ calculators…`} aria-label="Search calculators" data-calc-search />
        <kbd>/</kbd>
      </div>
    </div>

    <div class="grid" data-grid>
      {
        categories.map((c) => (
          <article class="card reveal" data-card>
            <div class="icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={c.icon} />
              </svg>
            </div>
            <h3>
              <a href={`#${c.id}`}>{c.title}</a>
            </h3>
            <p>{c.blurb}</p>
            <ul>
              {c.calcs.map((name) => (
                <li data-name={name.toLowerCase()}>
                  <a href={calcLinks[name] ? url(calcLinks[name]) : '#'}>{name}</a>
                </li>
              ))}
            </ul>
            <a href={`#${c.id}`} class="more">
              View all
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </article>
        ))
      }
    </div>
    <p class="empty" data-empty hidden>No calculators match that search. Try “weir”, “pipe”, or “runoff”.</p>
  </div>
</section>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .top .section-head {
    margin-bottom: 0;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(380px, 100%);
    height: 54px;
    padding: 0 14px 0 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow);
    color: var(--muted);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .search:focus-within {
    border-color: var(--water);
    box-shadow:
      0 0 0 4px rgba(31, 142, 241, 0.14),
      var(--shadow);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    font: 500 16px var(--font-sans);
    color: var(--text);
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 26px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .card[hidden] {
    display: none;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: #c8d6e4;
  }
  .icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--water-soft);
    color: var(--water);
  }
  h3 {
    font-size: 20px;
    margin-top: 20px;
  }
  h3 a {
    text-decoration: none;
  }
  .card > p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14.5px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 18px 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  li a {
    display: inline-block;
    font-size: 13px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink-3);
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  li a:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  li.match a {
    background: var(--water);
    border-color: var(--water);
    color: #fff;
  }
  .more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    font-size: 14px;
    color: var(--water);
    text-decoration: none;
  }
  .more:hover {
    gap: 10px;
  }
  .empty {
    text-align: center;
    color: var(--muted);
    padding: 40px 0;
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 22px;
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-calc-search]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const title = card.querySelector('h3')!.textContent!.toLowerCase();
      const items = [...card.querySelectorAll<HTMLElement>('li')];
      let any = !q || title.includes(q);
      for (const li of items) {
        const hit = !!q && li.dataset.name!.includes(q);
        li.classList.toggle('match', hit);
        if (hit) any = true;
      }
      card.hidden = !any;
      if (any) shown++;
    }
    empty.hidden = shown > 0;
  });
</script>
